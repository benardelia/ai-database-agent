# Running via docker-compose.yml and Ollama is on the host machine (not
# containerized)? Use http://host.docker.internal:11434 instead --
# "localhost" inside a container means the container itself, not the host.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Per-request timeout in seconds. Ollama unloads an idle model from memory
# after OLLAMA_KEEP_ALIVE and has to reload it on the next request, which
# can be slow on its own -- increase this if you see ReadTimeout errors.
OLLAMA_TIMEOUT_SECONDS=180
# How long Ollama keeps the model resident between requests.
OLLAMA_KEEP_ALIVE=30m

# Database connections (URL, schemas, excluded tables, glossary) live in
# databases.json (gitignored) -- see databases.example.json for the shape.
